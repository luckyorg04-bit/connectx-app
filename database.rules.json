{
  "rules": {
    ".read": false,
    ".write": false,
    "PublicUsers": {
      ".read": "auth != null",
      ".indexOn": ["username"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name', 'username', 'key', 'online', 'lastSeen', 'bio', 'photoUrl']) && newData.child('key').val() == $uid && newData.child('name').isString() && newData.child('username').isString() && newData.child('online').isBoolean() && newData.child('lastSeen').isNumber() && newData.child('bio').isString() && newData.child('photoUrl').isString()"
        ,"$other": {
          ".validate": "$other == 'name' || $other == 'username' || $other == 'key' || $other == 'online' || $other == 'lastSeen' || $other == 'bio' || $other == 'photoUrl'"
        }
      }
    },
    "PrivateUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "PhoneLookup": {
      "$phoneHash": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid) && newData.val() == auth.uid",
        ".validate": "newData.isString()"
      }
    },
    "PrivateTokens": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isString()"
      }
    },
    "BlockLists": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$blockedUid": {
          ".read": "auth != null && (auth.uid == $uid || auth.uid == $blockedUid)",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == true"
        }
      }
    },
    "Typing": {
      "$ownerUid": {
        "$viewerUid": {
          ".read": "auth != null && (auth.uid == $ownerUid || auth.uid == $viewerUid)",
          ".write": "auth != null && auth.uid == $ownerUid",
          ".validate": "newData.val() == true"
        }
      }
    }
  }
}
