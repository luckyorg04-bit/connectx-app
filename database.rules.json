{
  "rules": {
    ".read": false,
    ".write": false,
    "PublicUsers": {
      ".read": "auth != null",
      ".indexOn": ["username"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name', 'username', 'key', 'online', 'lastSeen', 'bio', 'photoUrl']) && newData.numChildren() == 7 && newData.child('key').val() == $uid && newData.child('name').val() is string && newData.child('username').val() is string && newData.child('online').val() is boolean && newData.child('lastSeen').val() is number && newData.child('bio').val() is string && newData.child('photoUrl').val() is string"
      }
    },
    "PrivateUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "PrivateTokens": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isString()"
      }
    },
    "BlockLists": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$blockedUid": {
          ".read": "auth != null && (auth.uid == $uid || auth.uid == $blockedUid)",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == true"
        }
      }
    },
    "Typing": {
      "$ownerUid": {
        "$viewerUid": {
          ".read": "auth != null && (auth.uid == $ownerUid || auth.uid == $viewerUid)",
          ".write": "auth != null && auth.uid == $ownerUid",
          ".validate": "newData.val() == true"
        }
      }
    }
  }
}
