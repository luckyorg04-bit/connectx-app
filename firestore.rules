rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(conversationId) {
      return signedIn() && request.auth.uid in conversationId.split(',');
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupChats/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberUids;
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupChats/$(groupId))
        && (
          request.auth.uid == get(/databases/$(database)/documents/groupChats/$(groupId)).data.createdBy
          || request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.get('adminUids', [])
        );
    }

    match /messages/{conversationId}/chats/{messageId} {
      allow read: if isParticipant(conversationId);

      allow create: if isParticipant(conversationId)
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.timestamp is int
        && request.resource.data.isRead == false
        && (!('isDelivered' in request.resource.data) || request.resource.data.isDelivered == false);

      allow update: if isParticipant(conversationId) && (
        (
          resource.data.sender == request.auth.uid
          && resource.data.timestamp is int
          && request.time.toMillis() >= resource.data.timestamp
          && request.time.toMillis() - resource.data.timestamp <= 900000
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['message', 'isEdited', 'editedAt'])
          && request.resource.data.message is string
          && request.resource.data.isEdited == true
        )
        ||
        (
          resource.data.sender != request.auth.uid
          && resource.data.isRead == false
          && request.resource.data.isRead == true
          && request.resource.data.isDelivered == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'isDelivered'])
        )
        ||
        (
          resource.data.sender != request.auth.uid
          && (!('isDelivered' in resource.data) || resource.data.isDelivered != true)
          && request.resource.data.isDelivered == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDelivered'])
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && resource.data.get('reactions', {}) is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {}))
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.reactions.keys().size() <= 2
          && (
            !request.resource.data.reactions.keys().hasAny([request.auth.uid])
            || (
              request.resource.data.reactions[request.auth.uid] is string
              && request.resource.data.reactions[request.auth.uid].size() <= 8
            )
          )
        )
        ||
        (
          'isViewOnce' in resource.data
          && resource.data.isViewOnce == true
          && resource.data.sender != request.auth.uid
          && 'viewedBy' in resource.data
          && resource.data.viewedBy is map
          && !resource.data.viewedBy.keys().hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
          && request.resource.data.viewedBy is map
          && request.resource.data.viewedBy.diff(resource.data.viewedBy).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.viewedBy[request.auth.uid] is timestamp
        )
        ||
        (
          'type' in resource.data
          && resource.data.type == 'poll'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes'])
          && request.resource.data.pollVotes is map
          && request.resource.data.pollVotes.diff(resource.data.pollVotes).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.pollVotes[request.auth.uid] is int
          && request.resource.data.pollVotes[request.auth.uid] >= 0
          && request.resource.data.pollVotes[request.auth.uid] < resource.data.pollOptions.size()
        )
      );

      allow delete: if isParticipant(conversationId)
        && resource.data.sender == request.auth.uid;
    }

    match /groupChats/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 2
        && request.resource.data.memberUids.size() <= 256
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.adminUids is list
        && request.auth.uid in request.resource.data.adminUids;
      allow update: if isGroupAdmin(groupId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'memberUids', 'adminUids'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 512
        && request.resource.data.memberUids is list
        && request.resource.data.adminUids is list
        && resource.data.createdBy in request.resource.data.memberUids
        && resource.data.createdBy in request.resource.data.adminUids
        && request.auth.uid in request.resource.data.memberUids;
      allow delete: if isGroupAdmin(groupId);

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.get('type', 'text') in ['text', 'poll', 'sticker']
          && (
            request.resource.data.get('type', 'text') != 'poll'
            || (
              request.resource.data.pollOptions is list
              && request.resource.data.pollOptions.size() >= 2
              && request.resource.data.pollOptions.size() <= 6
              && request.resource.data.pollVotes is map
            )
          );
        allow update: if isGroupMember(groupId)
          && resource.data.type == 'poll'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes'])
          && request.resource.data.pollVotes is map
          && request.resource.data.pollVotes.diff(resource.data.pollVotes).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.pollVotes[request.auth.uid] is int
          && request.resource.data.pollVotes[request.auth.uid] >= 0
          && request.resource.data.pollVotes[request.auth.uid] < resource.data.pollOptions.size();
        allow delete: if false;
      }
    }

    match /statuses/{statusId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.statusText is string
        && request.resource.data.statusText.size() <= 500
        && request.resource.data.mediaType in ['text', 'image', 'video']
        && (request.resource.data.mediaType != 'text' || request.resource.data.statusText.size() > 0)
        && (request.resource.data.mediaType == 'text' || request.resource.data.mediaUrl is string)
        && request.resource.data.audienceUids is list
        && request.auth.uid in request.resource.data.audienceUids
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      // Status metadata is visible to signed-in users. Media downloads are
      // separately authorized by the VPS against the captured audience list.
      allow read: if signedIn()
        && request.auth.uid in resource.data.audienceUids;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      match /views/{viewerUid} {
        allow create: if signedIn()
          && request.auth.uid == viewerUid
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time
          && request.auth.uid in get(/databases/$(database)/documents/statuses/$(statusId)).data.audienceUids
          && request.resource.data.viewerUid == request.auth.uid;
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/statuses/$(statusId)).data.ownerUid == request.auth.uid
            || request.auth.uid == viewerUid
          );
        allow update, delete: if false;
      }
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminUids is list
        && request.auth.uid in request.resource.data.adminUids
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids is list
          && (
            (
              request.auth.uid in request.resource.data.memberUids
              && !(request.auth.uid in resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
              && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            )
            ||
            (
              request.auth.uid in resource.data.memberUids
              && request.auth.uid != resource.data.ownerUid
              && !(request.auth.uid in request.resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
              && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            )
          )
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
        )
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /posts/{postId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.memberUids;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.memberUids
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids is list
          && (
            (
              request.auth.uid in request.resource.data.memberUids
              && !(request.auth.uid in resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
              && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            )
            ||
            (
              request.auth.uid in resource.data.memberUids
              && request.auth.uid != resource.data.ownerUid
              && !(request.auth.uid in request.resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
              && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            )
          )
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
        )
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /posts/{postId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.memberUids;
        allow create: if signedIn()
          && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid == request.auth.uid
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      function callParticipant() {
        return signedIn()
          && request.auth.uid in resource.data.participants;
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'callerUid', 'calleeUid', 'participants', 'type', 'status', 'createdAt'
        ])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid.size() > 0
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([request.auth.uid, request.resource.data.calleeUid])
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['voice', 'video']
        && request.resource.data.createdAt == request.time;

      allow read: if callParticipant();

      allow update: if callParticipant() && (
        (
          resource.data.callerUid == request.auth.uid
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
              && resource.data.status == 'ringing'
              && request.resource.data.offer is map
              && request.resource.data.offer.sdp is string
              && request.resource.data.offer.sdp.size() > 0
              && request.resource.data.offer.type == 'offer'
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedAt'])
              && resource.data.status == 'accepted'
              && !('connectedAt' in resource.data)
              && request.resource.data.connectedAt == request.time
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
              && request.resource.data.status in ['cancelled', 'missed', 'failed', 'ended']
              && resource.data.status in ['ringing', 'accepted']
              && request.resource.data.endedAt == request.time
            )
          )
        )
        || (
          resource.data.calleeUid == request.auth.uid
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'acceptedAt'])
              && resource.data.status == 'ringing'
              && request.resource.data.status == 'accepted'
              && request.resource.data.answer is map
              && request.resource.data.answer.sdp is string
              && request.resource.data.answer.sdp.size() > 0
              && request.resource.data.answer.type == 'answer'
              && request.resource.data.acceptedAt == request.time
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedAt'])
              && resource.data.status == 'accepted'
              && !('connectedAt' in resource.data)
              && request.resource.data.connectedAt == request.time
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
              && request.resource.data.status in ['declined', 'busy', 'ended']
              && resource.data.status in ['ringing', 'accepted']
              && request.resource.data.endedAt == request.time
            )
          )
        )
      );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() > 0;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() > 0;
        allow update, delete: if false;
      }
    }

    match /groupCalls/{callId} {
      function isCallGroupMember() {
        return signedIn()
          && resource.data.groupMemberUids is list
          && request.auth.uid in resource.data.groupMemberUids
          && exists(/databases/$(database)/documents/groupChats/$(resource.data.groupId))
          && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(resource.data.groupId)).data.memberUids
          && resource.data.expiresAt > request.time;
      }
      function isActiveCallParticipant() {
        return signedIn() && request.auth.uid in resource.data.activeUids;
      }
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.groupMemberUids is list
        && exists(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId))
        && request.resource.data.groupMemberUids.size() == get(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId)).data.memberUids.size()
        && request.resource.data.groupMemberUids.hasAll(get(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId)).data.memberUids)
        && request.auth.uid in request.resource.data.groupMemberUids
        && request.resource.data.activeUids == [request.auth.uid]
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.type in ['voice', 'video']
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(4, 'h');
      allow get: if isCallGroupMember();
      // The Calls tab queries this collection with participants arrayContains uid.
      // Keep the list rule aligned with that exact query so Firestore can prove access.
      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow update: if isCallGroupMember() && (
        (
          request.resource.data.activeUids is list
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeUids', 'participants'])
              && request.auth.uid in request.resource.data.activeUids
              && !(request.auth.uid in resource.data.activeUids)
              && request.resource.data.activeUids.size() == resource.data.activeUids.size() + 1
              && request.resource.data.activeUids.size() <= 8
              && request.resource.data.activeUids.hasAll(resource.data.activeUids)
              && request.resource.data.participants is list
              && request.resource.data.participants.size() >= resource.data.participants.size()
              && request.resource.data.participants.size() <= resource.data.participants.size() + 1
              && request.resource.data.participants.hasAll(resource.data.participants)
              && request.auth.uid in request.resource.data.participants
            )
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeUids'])
              && request.auth.uid in resource.data.activeUids
              && !(request.auth.uid in request.resource.data.activeUids)
              && request.resource.data.activeUids.size() == resource.data.activeUids.size() - 1
              && resource.data.activeUids.hasAll(request.resource.data.activeUids)
            )
          )
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
          && (
            resource.data.createdBy == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/groupChats/$(resource.data.groupId)).data.get('adminUids', [])
          )
          && request.resource.data.status == 'ended'
        )
      );
      allow delete: if false;

      match /pairs/{pairId} {
        function activeParticipant(uid) {
          return uid in get(/databases/$(database)/documents/groupCalls/$(callId)).data.activeUids;
        }
        allow read: if signedIn() && activeParticipant(request.auth.uid);
        allow create: if signedIn()
          && activeParticipant(request.auth.uid)
          && request.resource.data.offererUid == request.auth.uid
          && activeParticipant(request.resource.data.answererUid)
          && request.resource.data.offer is map;
        allow update: if signedIn()
          && activeParticipant(request.auth.uid)
          && (
            (
              resource.data.offererUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
            )
            ||
            (
              resource.data.answererUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'updatedAt'])
              && request.resource.data.answer is map
            )
          );
        allow delete: if false;

        match /candidates/{candidateId} {
          allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(callId)).data.activeUids;
          allow create: if signedIn()
            && request.resource.data.senderUid == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(callId)).data.activeUids;
          allow update, delete: if false;
        }
      }
    }

    match /appConfig/{configId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}
