rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(conversationId) {
      return signedIn() && request.auth.uid in conversationId.split(',');
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupChats/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberUids;
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupChats/$(groupId))
        && (
          request.auth.uid == get(/databases/$(database)/documents/groupChats/$(groupId)).data.createdBy
          || request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.get('adminUids', [])
        );
    }

    match /messages/{conversationId}/chats/{messageId} {
      allow read: if isParticipant(conversationId);

      allow create: if isParticipant(conversationId)
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.timestamp is int
        && request.resource.data.isRead is bool;

      allow update: if isParticipant(conversationId) && (
        (
          resource.data.sender == request.auth.uid
          && request.time.toMillis() - resource.data.timestamp <= 900000
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['message', 'isEdited', 'editedAt'])
          && request.resource.data.message is string
          && request.resource.data.isEdited == true
        )
        ||
        (
          resource.data.sender != request.auth.uid
          && resource.data.isRead == false
          && request.resource.data.isRead == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
        )
        ||
        (
          resource.data.isViewOnce == true
          && resource.data.sender != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
          && request.resource.data.viewedBy is map
          && request.resource.data.viewedBy.diff(resource.data.viewedBy).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.viewedBy[request.auth.uid] is timestamp
        )
        ||
        (
          resource.data.type == 'poll'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes'])
          && request.resource.data.pollVotes is map
          && request.resource.data.pollVotes.diff(resource.data.pollVotes).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.pollVotes[request.auth.uid] is int
          && request.resource.data.pollVotes[request.auth.uid] >= 0
          && request.resource.data.pollVotes[request.auth.uid] < resource.data.pollOptions.size()
        )
      );

      allow delete: if isParticipant(conversationId)
        && resource.data.sender == request.auth.uid;
    }

    match /groupChats/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.adminUids is list
        && request.auth.uid in request.resource.data.adminUids;
      allow update: if isGroupAdmin(groupId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberUids', 'adminUids'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.memberUids is list
        && request.resource.data.adminUids is list
        && resource.data.createdBy in request.resource.data.memberUids
        && resource.data.createdBy in request.resource.data.adminUids
        && request.auth.uid in request.resource.data.memberUids;
      allow delete: if isGroupAdmin(groupId);

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if false;
      }
    }

    match /statuses/{statusId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.statusText is string
        && request.resource.data.statusText.size() <= 500
        && request.resource.data.mediaType in ['text', 'image', 'video']
        && (request.resource.data.mediaType != 'text' || request.resource.data.statusText.size() > 0)
        && (request.resource.data.mediaType == 'text' || request.resource.data.mediaUrl is string)
        && request.resource.data.audienceUids is list
        && request.auth.uid in request.resource.data.audienceUids
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow read: if signedIn()
        && request.auth.uid in resource.data.audienceUids
        && resource.data.expiresAt > request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      match /views/{viewerUid} {
        allow create: if signedIn()
          && request.auth.uid == viewerUid
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time
          && request.auth.uid in get(/databases/$(database)/documents/statuses/$(statusId)).data.audienceUids
          && request.resource.data.viewerUid == request.auth.uid;
        allow read: if signedIn()
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.ownerUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
        )
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
        )
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid == request.auth.uid
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['voice', 'video'];
      allow read: if signedIn()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid);
      allow update: if signedIn() && (
        (
          resource.data.callerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'status', 'endedAt'])
        )
        || (
          resource.data.calleeUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'acceptedAt', 'endedAt'])
        )
      );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}
